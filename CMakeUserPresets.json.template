{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 1
    },
    "configurePresets": [
        {
            "name": "dev-common",
            "hidden": true,
            "binaryDir": "C:/b",
            "cacheVariables": {
                "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=C:/b/build",
                "AWS_S3_BUCKET_NAME": "<bucket-name>",
                "AWS_ACCESS_KEY_ID": "<access-key-id>",
                "AWS_SECRET_ACCESS_KEY": "/base64+encrypted+secret+access+key/",
                "AWS_CRYPTO_KEY": "0"
            }
        },
        {
            "name": "dev-debug",
            "inherits": ["dev-common", "debug"]
        },
        {
            "name": "dev-release",
            "inherits": ["dev-common", "release"]
        }
    ],
    "buildPresets": [
        {
            "name": "dev-debug",
            "configurePreset": "dev-debug"
        },
        {
            "name": "dev-release",
            "configurePreset": "dev-release"
        }
    ]
}