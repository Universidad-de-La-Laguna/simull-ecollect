{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 1
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default static build, including AWS secrets",
            "inherits": "base",
            "cacheVariables": {
                "AWS_S3_BUCKET_NAME": "$env{AWS_S3_BUCKET_NAME}",
                "AWS_ACCESS_KEY_ID": "$env{AWS_ACCESS_KEY_ID}",
                "AWS_SECRET_ACCESS_KEY": "$env{AWS_SECRET_ACCESS_KEY}",
                "AWS_CRYPTO_KEY": "$env{AWS_CRYPTO_KEY}"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}