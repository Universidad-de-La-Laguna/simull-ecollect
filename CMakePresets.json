{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 1
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default static build using Ninja generator",
            "generator": "Ninja",
            "binaryDir": "V:/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "V:/scripts/buildsystems/vcpkg.cmake",
                "STATIC_BUILD": "ON",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/tools/vcpkg-manifest"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}