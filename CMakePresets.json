{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 21,
      "patch": 1
    },
    "configurePresets": [
        {
            "name": "default",
            "generator": "Ninja",
            "hidden": true,
            "binaryDir": "C:/b",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "STATIC_BUILD": "ON",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/tools/vcpkg-triplets",
                "VCPKG_TARGET_TRIPLET": "x64-windows-release",
                "VCPKG_HOST_TRIPLET": "x64-windows-release",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/tools/vcpkg-manifest",
                "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=C:/b/build"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}