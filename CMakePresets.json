{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default donfig using Ninja generator with vcpkg toolchain",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": {
                "type": "FILEPATH",
                "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                },
                "VCPKG_MANIFEST_DIR": "${sourceDir}/vcpkg-full.json",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "VCPKG_INSTALL_OPTIONS": "--clean-after-build",
                "AWS_S3_BUCKET_NAME": "$env{AWS_S3_BUCKET_NAME}",
                "AWS_ACCESS_KEY_ID": "$env{AWS_ACCESS_KEY_ID}",
                "AWS_SECRET_ACCESS_KEY": "$env{AWS_SECRET_ACCESS_KEY}",
                "AWS_CRYPTO_KEY": "$env{AWS_CRYPTO_KEY}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "displayName": "Build Default Config",
            "description": "Build using default configurations"
        }
    ]
}